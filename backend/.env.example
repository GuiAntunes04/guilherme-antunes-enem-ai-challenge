PORT=3001
NODE_ENV=development
# Comma-separated origins for CORS (local + Vercel production)
FRONTEND_URL=http://localhost:5173,https://enem-prep-ai.vercel.app

# Supabase — Project Settings → API
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Google Gemini — https://aistudio.google.com/
GEMINI_API_KEY=
# Chaves reserva (vírgula): após esgotar GEMINI_MODEL_FALLBACKS na chave atual (quota ou overload)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=

# EnemHub API — https://docs.enemhub.com.br/enem/quickstart
ENEMHUB_API_KEY=
ENEMHUB_API_KEYS=

# Opcional: habilita POST /api/enem/sync com header X-Question-Index-Sync-Secret (senão use npm run sync:questions)
QUESTION_INDEX_SYNC_SECRET=
